# RackPlane Environment Configuration
# Copy this file to .env and update with your actual values
# cp env.example .env

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://dcms:dcms_password@db:5432/datacenter_inventory

# =============================================================================
# Redis Configuration
# =============================================================================
# Redis connection URL for caching and task queue
REDIS_URL=redis://redis:6379/0

# =============================================================================
# Security Configuration
# =============================================================================
# Secret key for JWT token signing - MUST be changed in production!
# Generate a secure key: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production

# JWT token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# Application Configuration
# =============================================================================
# Enable debug mode (shows detailed error messages) - set to False in production
DEBUG=False

# CORS origins - CRITICAL: Must be configured for your deployment!
# Default restricts to localhost for security. MUST be updated for:
#   - Production deployments (use your domain)
#   - Reverse proxy setups (use proxy origin, e.g., "https://dcms.example.com")
#   - Docker network access (add container hostnames if needed)
#   - IP address access (add IP origins, e.g., "http://192.168.1.100:3000")
# Format: ["http://localhost:3000", "https://app.example.com"]
# For development with proxy: ["http://localhost:3000", "https://proxy.example.com"]
# WARNING: Using ["*"] allows all origins - ONLY for development!
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8000"]

# Enable email alerts globally
ENABLE_EMAIL_ALERTS=true

# Enable specific alert types
LOW_STOCK_ALERT_ENABLED=true
MAINTENANCE_ALERT_ENABLED=true
WARRANTY_ALERT_ENABLED=true

# =============================================================================
# SMTP Configuration (Alternative to SendGrid)
# =============================================================================
# Use these if EMAIL_PROVIDER=smtp instead of SendGrid
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# =============================================================================
# File Storage Configuration
# =============================================================================
# Directory for uploaded files (photos, documents)
UPLOAD_DIR=/app/uploads

# Maximum file upload size in bytes (default: 10MB)
MAX_UPLOAD_SIZE=10485760

# Interval between maintenance checks in hours
MAINTENANCE_CHECK_INTERVAL_HOURS=24

# =============================================================================
# Asset Lifecycle Warnings (Optional - defaults shown)
# =============================================================================
# Days before end-of-life to show warnings
EOL_WARNING_DAYS=90

# Days before warranty expiration to show warnings
WARRANTY_WARNING_DAYS=30
