# RackPlane Backend Environment Variables
# Copy this to .env and fill in your values

# ===========================================
# REQUIRED: Database
# ===========================================
DATABASE_URL=postgresql://dcms:dcms_password@db:5432/datacenter_inventory

# ===========================================
# REQUIRED: Security
# ===========================================
SECRET_KEY=your-secure-secret-key-here

# ===========================================
# OPTIONAL: Price Search APIs
# ===========================================

# SerpApi - For Google Shopping price lookups (recommended)
# Sign up at: https://serpapi.com
# Pricing: ~$0.015 per search
SERPAPI_API_KEY=

# ZenRows - For vendor site scraping (datasheets, specs)
# Sign up at: https://zenrows.com
# Pricing: ~$0.0025 per request (basic), $0.025 with premium proxy
ZENROWS_API_KEY=

# Mouser - For electronic component lookups
# Sign up at: https://www.mouser.com/api-hub/
# Free tier available
MOUSER_API_KEY=

# ===========================================
# OPTIONAL: Other Integrations
# ===========================================

# FS.com API (for direct FS.com catalog access)
FS_CLIENT_ID=
FS_CLIENT_SECRET=

# NetBox Integration
NETBOX_URL=
NETBOX_TOKEN=

# Email (SendGrid)
SENDGRID_API_KEY=
FROM_EMAIL=alerts@rackplane.com
